// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Berita {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  thumbnail   String

  category    String
  author      String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags        BeritaTag[]
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique

  berita  BeritaTag[]
}

model BeritaTag {
  beritaId String
  tagId    String

  berita   Berita @relation(fields: [beritaId], references: [id])
  tag      Tag    @relation(fields: [tagId], references: [id])

  @@id([beritaId, tagId])
}

model PejabatStruktural {
  id        String   @id @default(cuid())
  nama      String
  foto      String?  // URL foto
  jabatan   Jabatan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Jabatan {
  KABAPAS
  KASUBSI_BKD
  KASUBSI_BKA
  KAUR_TU
}

model Admin {
    id       Int    @id @default(autoincrement())
    name     String
    email    String @unique
    password String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Pengaduan {
  id          String   @id @default(cuid())
  nama        String
  kontak      String
  kategori    String
  deskripsi   String
  lampiran    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Publikasi {
  id          String   @id @default(cuid())
  title       String
  description String

  fileUrl     String
  fileName    String

  createdAt   DateTime @default(now())
}

model WilayahKerja {
  id           Int      @id @default(autoincrement())
  
  nama         String   @unique
  image        String
  klienDewasa  Int      @default(0)
  klienAnak    Int      @default(0)
  klienTotal   Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Anggaran {
  id              String   @id @default(cuid())

  tahun           Int      @unique

  totalAnggaran   BigInt

  realisasi       BigInt

  createdAt       DateTime @default(now())

  updatedAt       DateTime @updatedAt
}

model Survey {
  id          String   @id @default(cuid())
  label       String
  title       String
  score       Float
  period      String
  respondents String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProfilKepalaBapas {
  id          String   @id @default(cuid())

  nama        String
  jabatan     String
  pangkat     String
  pendidikan  String
  foto        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  riwayatPendidikan Pendidikan[]
  riwayatJabatan    JabatanRiwayat[]
  penghargaan       Penghargaan[]
  diklat            Diklat[]
  organisasi        Organisasi[]
  pengalaman        PengalamanInternasional[]
  prestasi          Prestasi[]
  kinerja           Kinerja[]
}
model Pendidikan {
  id        String   @id @default(cuid())
  nama      String
  tahun     String
  jenjang   String
  jurusan   String

  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JabatanRiwayat {
  id        String   @id @default(cuid())
  nama      String
  tahun     String

  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Penghargaan {
  id        String   @id @default(cuid())
  nama      String
  tahun     String

  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Diklat {
  id        String   @id @default(cuid())
  nama      String
  tahun     String
  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organisasi {
  id        String   @id @default(cuid())
  nama      String
  tahun     String
  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PengalamanInternasional {
  id        String   @id @default(cuid())
  nama      String
  tahun     String
  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prestasi {
  id        String   @id @default(cuid())
  nama      String
  profilId  String
  profil    ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kinerja {
  id              String   @id @default(cuid())
  nama            String
  hasil           String
  profilId        String
  profil          ProfilKepalaBapas @relation(fields: [profilId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dashboard {
  id String @id @default(cuid())

  jenisPidana JenisPidana[]
  klien       KlienSummary?
  litmas      Litmas?
  pendampingan Pendampingan?
  sdm         SDM?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model JenisPidana {
  id      String @id @default(cuid())
  label   String
  value   Int

  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
}

model KlienSummary {
  id String @id @default(cuid())

  apelCB   Int @default(0)
  apelCMB  Int @default(0)
  apelPB   Int @default(0)
  apelPIB  Int @default(0)

  baruCB   Int @default(0)
  baruCMB  Int @default(0)
  baruPB   Int @default(0)
  baruPIB  Int @default(0)

  dashboardId String @unique
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
}

model Litmas {
  id String @id @default(cuid())

  // DEWASA
  dewasaPB            Int @default(0)
  dewasaCB            Int @default(0)
  dewasaCMB           Int @default(0)
  dewasaPembinaanAwal Int @default(0)
  dewasaPerubahan     Int @default(0)
  dewasaMutasi        Int @default(0)
  dewasaPraAjudikasi  Int @default(0)

  // ANAK
  anakSidang          Int @default(0)
  anakDiversi         Int @default(0)
  anakPB              Int @default(0)
  anakCB              Int @default(0)
  anakPembinaanAwal   Int @default(0)
  anakKorban          Int @default(0)
  anakKurang12Tahun   Int @default(0)

  dashboardId String @unique
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
}

model Pendampingan {
  id String @id @default(cuid())

  diversi     Int @default(0)
  sidang      Int @default(0)
  pengakhiran Int @default(0)
  pencabutan  Int @default(0)
  pelimpahan  Int @default(0)

  dashboardId String @unique
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
}

model SDM {
  id String @id @default(cuid())

  hadir           Int @default(0)
  cuti            Int @default(0)
  dinasLuar       Int @default(0)
  posBapas        Int @default(0)
  tanpaKeterangan Int @default(0)

  dashboardId String @unique
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id])
}